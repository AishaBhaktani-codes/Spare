# ==========================================
# GapGraph Environment Configuration
# ==========================================

# ------------------------------------------
# Backend Services (backend/.env)
# ------------------------------------------
# Server Port
PORT=3001

# PostgreSQL Database Connection URL
# Local Docker instance: postgresql://gapgraph:gapgraph_secret@localhost:5432/gapgraph?schema=public
DATABASE_URL="postgresql://gapgraph:gapgraph_secret@localhost:5432/gapgraph?schema=public"

# Groq AI API Key (Primary High-Speed LLM Engine)
# Powers multi-level student pursuit branching, field verification, and skill gap intelligence
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Optional AI Fallbacks
BYTEZ_API_KEY="your_bytez_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# ------------------------------------------
# Frontend Client (Frontend/gapgraph/.env.local)
# ------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"
