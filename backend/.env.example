# ==========================================
# GapGraph Backend Environment Configuration
# ==========================================

# Server Port
PORT=3001

# Database Configuration (PostgreSQL)
# Local Docker: postgresql://gapgraph:gapgraph_secret@localhost:5432/gapgraph?schema=public
# Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://gapgraph:gapgraph_secret@localhost:5432/gapgraph?schema=public"

# Groq AI API Key (Primary High-Speed LLM Engine)
# Required for dynamic pursuit branching, field of interest verification, and skill rating diagnostics
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Optional LLM Fallback Integrations
BYTEZ_API_KEY="your_bytez_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
